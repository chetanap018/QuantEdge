# ============================================================
# Angel One SmartAPI credentials  (.env.example - safe to commit)
# Copy to .env and fill in your REAL keys from:
#   https://smartapi.angelone.in/
# Loaded automatically by config.py at startup.
# ============================================================
ANGEL_API_KEY=YOUR_ANGEL_API_KEY
ANGEL_CLIENT_ID=YOUR_ANGEL_CLIENT_ID
ANGEL_CLIENT_PIN=YOUR_ANGEL_CLIENT_PIN
ANGEL_TOTP_KEY=YOUR_TOTP_SECRET

# Zerodha Kite (alternative data source) -- uncomment if you use it
# ZERODHA_API_KEY=YOUR_ZERODHA_API_KEY
# ZERODHA_ACCESS_TOKEN=YOUR_ACCESS_TOKEN

# Google Gemini API key for AI strategy generation
GEMINI_API_KEY=paste_your_gemini_api_key_here

# Output budget per model call, in tokens. A lengthy strategy description makes
# the model write a long preamble plus a long class; if the response is cut off
# mid-code-block the generation loop escalates this budget (up to 8192) and
# retries the same attempt. Optional, default 4096, clamped 256-8192.
# GEMINI_MAX_OUTPUT_TOKENS=4096

# How many model calls one strategy generation may use: the first attempt plus
# the automatic repairs of drafts that fail validation/dry-run. Optional,
# default 3, clamped to 1-6. Set 1 to disable self-repair.
# AI_STRATEGY_MAX_ATTEMPTS=3

# Seconds to pause between model calls. Free/limited Gemini tiers have
# requests-per-minute quotas and a repair fires a second call right after a
# rejected one, which is what triggers 429 / quota errors. A throttled call is
# also retried after this pause. Optional, default 30, clamped to 0-300.
# 30-60 suits the usual 2-15 requests/minute limits; 0 disables the pause.
# AI_STRATEGY_REPAIR_DELAY_SECONDS=30

# Extra model calls allowed purely to retry a throttled (429 / quota / 503)
# response, on top of AI_STRATEGY_MAX_ATTEMPTS. Each retry waits at least
# AI_STRATEGY_REPAIR_DELAY_SECONDS, and longer when Gemini's own error body
# says "Please retry in Xs". Optional, default 3, clamped 0-5.
# AI_STRATEGY_RATE_LIMIT_RETRIES=3

# Extra model calls allowed purely to retry a response that was cut off by the
# output token limit (each retry uses a bigger budget). Optional, default 2,
# clamped 0-5.
# AI_STRATEGY_TRUNCATION_RETRIES=2

# Cap, in seconds, on how long ONE automatic retry may wait when Gemini's error
# asks for a back-off. Free-tier daily-quota 429s ask for minutes or hours;
# those fail fast with a clear message instead of freezing the UI.
# Optional, default 120, clamped 1-3600.
# AI_STRATEGY_MAX_RETRY_WAIT_SECONDS=120

# Backtest Studio UI port (optional, default 5000)
# PORT=5000
